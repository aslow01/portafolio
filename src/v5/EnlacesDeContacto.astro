---
// Los enlaces de cierre de las páginas de casos: «Descargar el CV …» y «Escribir por correo». La ruta y el detalle del PDF
// salen de lib/datos-pendientes.ts y el correo, de lib/sitio.ts (`mailto`): nada se escribe a mano acá. Sin PDF, el
// primero no se dibuja. Solo son los enlaces: el contenedor y su disposición los pone quien lo usa.
import { cvDe, cvEnEspanol } from '../lib/datos-pendientes.ts';
import { mailto } from '../lib/sitio.ts';
import { idiomaDe, traductor } from '../i18n/idioma';

interface Props {
	/** El CV que se ofrece: el del camino de la carpeta donde se lee (por defecto, el técnico). `ambos`: los dos (el índice de casos no es de ninguna carpeta). */
	camino?: 'tecnico' | 'logistica' | 'ambos';
}
const { camino = 'tecnico' } = Astro.props;
const idioma = idiomaDe(Astro.currentLocale);
const t = traductor(idioma);
const cv = cvDe(idioma);
const ambos = camino === 'ambos';
const caminos = ambos ? (['tecnico', 'logistica'] as const) : ([camino] as const);
const nombreCv = {
	// En inglés va con mayúscula: en el índice de casos, en pantallas angostas queda solo el nombre («Technical CV»).
	tecnico: t('CV técnico', 'Technical CV'),
	logistica: t('CV de logística', 'Logistics CV'),
} as const;
---

{
	caminos.map((c) => {
		const pdf = cv[c];
		return (
			pdf && (
				<a class="enlace baja" href={pdf.archivo} download>
					{
						ambos ? (
							<span>
								<span class="larga">{t('Descargar el ', 'Download ')}</span>
								{nombreCv[c]}
								{cvEnEspanol(c, idioma) && (
									<Fragment>
										{/* En una pantalla angosta («Download the» se oculta a la vista) el aviso se acorta a «(ES)»; para el lector sigue entero. */}
										<span class="larga"> (Spanish)</span>
										<span class="corta" aria-hidden="true"> (ES)</span>
									</Fragment>
								)}
							</span>
						) : (
							`${t('Descargar el ', 'Download the ')}${nombreCv[c]}${cvEnEspanol(c, idioma) ? ' (Spanish)' : ''}`
						)
					}<span class="solo-lector">: {pdf.detalle}</span>
				</a>
			)
		);
	})
}
<a class="enlace" href={mailto()}>{t('Escribir por correo', 'Send an email')}</a>
