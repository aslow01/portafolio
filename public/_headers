# Cabeceras de seguridad (Cloudflare Pages). Se prueban en scripts/cabeceras.test.mjs.
# Analítica: Cloudflare Web Analytics (sin cookies). Es lo único externo: script-src admite static.cloudflareinsights.com
# (el beacon) y connect-src cloudflareinsights.com (donde envía la medición). Todo lo demás queda en el propio origen.
# HSTS (Strict-Transport-Security) NO va acá: se activa en la zona de Cloudflare (SSL/TLS > Edge Certificates) al publicar.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; connect-src 'self' https://cloudflareinsights.com; style-src 'self'; img-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Cross-Origin-Opener-Policy: same-origin
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

# Archivos con nombre por contenido (hash): se pueden guardar para siempre.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Fuentes autoalojadas: el nombre lleva versión (-v1); si un archivo cambia, cambia el nombre.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Imágenes para compartir (public/og/): el nombre lleva la huella de su contenido (scripts/og/generar.mjs), así que se guardan para siempre.
/og/*
  Cache-Control: public, max-age=31536000, immutable
