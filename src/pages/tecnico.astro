---
// Camino técnico e IA, web v5.
// Es la ficha 02 abierta y suelta («fija»): once páginas en horizontal, cada una a una pantalla.
// 1 Tapa · 2 El caso · 3 Cómo trabajo · 4 Mi parte · 5 Cómo se verificó · 6 Circuito · 7 Prueba: el centavo ·
// 8 Prueba: el día · 9 Método · 10 Laboratorio · 11 Traductor (las piezas propias, al final: las páginas 2 a 8 cuentan el caso en orden).
// Los demás casos de estudio se alcanzan por una sola entrada, «Casos de estudio» (/casos/).
// Los textos y las cifras salen de src/content y src/lib (nada se escribe acá si ya está allá);
// lo que se arma a partir de ellos está en src/v5/fichas/tecnico-datos.ts. Cada página lleva su `id` (#el-caso…): con
// ese hash la ficha abre en ella (pestanas.ts). El comportamiento propio («Atrás» con la hoja de código abierta) está en
// src/scripts/v5/tecnico.ts.
import BaseV5 from '../layouts/BaseV5.astro';
import EnlaceArchivo from '../v5/EnlaceArchivo.astro';
import Ficha from '../v5/Ficha.astro';
import Lomos from '../v5/Lomos.astro';
import CartaAtras from '../v5/CartaAtras.astro';
import Pagina from '../v5/Pagina.astro';
import '../styles/v5/cartas.css';
import '../v5/fichas/tecnico-comun.css';
import { circuitoDe } from '../lib/circuito.ts';
import { esDeCamino, filasAutoria, obraPrincipal } from '../lib/contenido.ts';
import { cvDe, cvEnEspanol } from '../lib/datos-pendientes.ts';
import { demoVisible, esPublicable, soloPublicable } from '../lib/estados.ts';
import { inventarioPublicado, textoEstadoDemo } from '../lib/presentacion.ts';
import { piezasTecnico } from '../lib/proyectos.ts';
import { mailto, textosSitio } from '../lib/sitio.ts';
import { casosDe, demoDe, demosDe, entradaReferida, proyectosDe } from '../i18n/colecciones';
import { idiomaDe, rutaDe, traductor } from '../i18n/idioma';
import { esReferencia, introIndependiente, resumenReferencias, trabajosAMostrar, vistaDe } from '../lib/trabajo-independiente.ts';
import { Image } from 'astro:assets';
import { estiloDePieza, idDePieza } from '../v5/fichas/piezas-tecnico';
import {
	casosCentavoDe,
	comprobarContraCodigo,
	flujoDeAutoria,
	frases,
	jornada,
	lecturasRelojDe,
	rotulosJornadaDe,
	leyendaTira,
	marcasReloj,
	nombrePaso,
} from '../v5/fichas/tecnico-datos';

const idioma = idiomaDe(Astro.currentLocale);
const t = traductor(idioma);
const cv = cvDe(idioma);
const circuitoLector = circuitoDe(idioma);
const { comoTrabajo, enfasisComoTrabajo, estudiosActuales, bajadaPortada } = textosSitio(idioma);
const casosCentavo = casosCentavoDe(idioma);
const lecturasReloj = lecturasRelojDe(idioma);
const rotulosJornada = rotulosJornadaDe(idioma);
const todos = (await casosDe(idioma, ({ data }) => esPublicable(data))).sort((a, b) => a.data.orden - b.data.orden);
const obra = obraPrincipal(todos.filter((c) => esDeCamino(c.data, 'tecnico')));
const demos = await demosDe(idioma, ({ data }) => demoVisible(data));
// Las piezas propias del camino técnico (método, laboratorio, traductor): las páginas 9 a 11, una carta grande cada una.
const piezas = piezasTecnico(await proyectosDe(idioma), undefined, idioma);
const inventario = inventarioPublicado(todos, demos, undefined, idioma);

// Trabajo independiente (src/lib/trabajo-independiente.ts): las referencias anónimas y los sitios con permiso del cliente; sin
// ninguno, la página no se genera. La vista previa con datos ficticios (variable VISTA_PREVIA=independiente) existe solo en `npm run dev`: en el
// build `import.meta.env.DEV` es falso y la variable no cuenta. En PowerShell: $env:VISTA_PREVIA = 'independiente'; npm run dev
const { lista: independientes, vistaPrevia } = trabajosAMostrar(
	process.env.VISTA_PREVIA === 'independiente',
	import.meta.env.DEV,
);
// Las referencias se juntan en una sola tarjeta (conteos y rubros); solo los sitios completos, con permiso, llevan tarjeta propia.
const resumen = independientes.some(esReferencia) ? resumenReferencias(independientes, idioma) : undefined;
// Las capturas: src/assets/independiente/ (y, solo para la vista previa, las de las demos, que son ficticias).
const imagenes = import.meta.glob<{ default: ImageMetadata }>('../assets/{independiente,capturas}/*.{png,jpg,jpeg,webp}', { eager: true });
const imagenDe = (ruta?: string) => (ruta ? imagenes[`../assets/${ruta}`]?.default : undefined);

// Demo de la obra principal (la del lector de facturas): de ahí salen el botón «Probar la demo», la prueba del
// centavo y el circuito. La de control de flota pone la prueba del cambio de día.
const demoObra = obra?.data.demo ? soloPublicable(await entradaReferida(obra.data.demo)) : undefined;
const demoFlota = soloPublicable(await demoDe(idioma, 'control-flota'));
const demoLector = soloPublicable(await demoDe(idioma, 'lector-facturas'));
const pruebaCentavo = demoObra?.data.prueba;
const pruebaDia = demoFlota && demoVisible(demoFlota.data) ? demoFlota.data.prueba : undefined;
// La web no puede mostrar una fila que la prueba no comprueba: si el código cambia, el build falla.
if (pruebaCentavo) comprobarContraCodigo(pruebaCentavo.codigo, casosCentavo.map((c) => c.fuente), 'Prueba del centavo');
if (pruebaDia) comprobarContraCodigo(pruebaDia.codigo, lecturasReloj.flatMap((l) => l.fuente), 'Prueba del día');

const cifras = jornada(obra?.data.resultado);
const linea = obra?.data.lineaObra;
const autoria = obra?.data.autoria;
const flujo = flujoDeAutoria(autoria?.yo, idioma);
const filas = filasAutoria(autoria, idioma);
const verificacion = frases(autoria?.verificacion ?? '');
// «Cómo se verificó»: la regla (su primera oración), tres controles y, lo que sigue, la nota del autor.
const reglaCaso = frases(obra?.data.regla ?? '')[0];
const controles = verificacion.slice(0, 3);
const notaControl = verificacion.slice(3).join(' ');
const [principio, ...resto] = frases(comoTrabajo);
// Las dos frases resaltadas del principio (lib/sitio.ts), sin tocar el texto.
const enfasis: readonly string[] = enfasisComoTrabajo;
const partesPrincipio = principio.split(new RegExp(`(${enfasis.join('|')})`)).filter((p) => p !== '');

const demoVivaLector = demoLector?.data.estado === 'en-vivo' && demoLector.data.demo ? demoLector.data.demo : undefined;
const repoLector = demoLector?.data.repo;
const repoFlota = demoFlota?.data.repo;
const ticks = marcasReloj();
---

<BaseV5
	titulo={t('Técnico e IA', 'Software and AI')}
	imagenSocial="tecnico"
	descripcion={`${t('Desarrollo de software y automatización con IA', 'Software development and AI automation')}${inventario ? `: ${inventario}` : ''}.`}
	saltar={{ href: '#t-tecnico', texto: t('Saltar al contenido', 'Skip to content') }}
>
	<main>
		<Ficha id="tecnico" fija>
			<!-- 1 · Tapa -->
			<Pagina id="tapa" titulo={t('Tapa', 'Cover')} tapa>
				{
					idioma === 'en' ? (
						<h1 class="h1-t cartel" id="t-tecnico" tabindex="-1">Software <span class="resto">development and AI automation</span></h1>
					) : (
						<h1 class="h1-t cartel" id="t-tecnico" tabindex="-1">Desarrollo <span class="resto">de software y automatización</span></h1>
					)
				}
				<p class="pg-lead">{bajadaPortada}</p>
				<p class="rotulo" data-consulta-invita>{t('Busco: desarrollo de software · remoto · abierto a otros países', 'Looking for: remote software development · open to international employers')}</p>
				<div class="acciones">
					{
						cv.tecnico && (
							<a class="boton baja" href={cv.tecnico.archivo} download>
								{t('Descargar el CV técnico', 'Download the software CV')}{cvEnEspanol('tecnico', idioma) && ' (Spanish)'}<span class="solo-lector">: {cv.tecnico.detalle}</span>
							</a>
						)
					}
					<EnlaceArchivo total={todos.length} />
					<a class="enlace" href={mailto()}>{t('Escribir por correo', 'Send an email')}</a>
				</div>
				{
					demoLector && (
						<figure class="tira" aria-labelledby="cap-tira">
							<span class="viaja" aria-hidden="true" />
							<ol aria-hidden="true">
								{circuitoLector.map((p, i) => <li class:list={['num', { cinco: p.acercamiento, persona: p.persona }]}>{i + 1}</li>)}
							</ol>
							<figcaption id="cap-tira">{leyendaTira(circuitoLector, idioma)}</figcaption>
						</figure>
					)
				}
			</Pagina>

			<!-- 2 · El caso -->
			{
				obra && (
					<Pagina id="el-caso" titulo={t('El caso', 'The case')}>
						<p class="rotulo">{t('Caso de estudio · anonimizado', 'Case study · anonymized')}</p>
						<h2 class="pg-sub largo">{obra.data.titulo}</h2>
						{
							cifras && (
								<figure class="jornada der">
									<div class="grupo antes">
										<span class="rot-g rotulo">{rotulosJornada.antes}</span>
										<span class="cifra-j cartel">{cifras.antes.cifra}</span>
										<span class="marcas" data-marcas={cifras.antes.marcas} aria-hidden="true" />
									</div>
									<div class="grupo ahora">
										<span class="rot-g rotulo">{rotulosJornada.ahora}</span>
										<span class="cifra-j cartel">{cifras.ahora.cifra}</span>
										<span class="marcas" data-marcas={cifras.ahora.marcas} aria-hidden="true" />
									</div>
									<figcaption>
										<span class="unidad">{cifras.unidad}<span class="una" aria-hidden="true">{t(' · una marca, una factura', ' · one mark, one invoice')}</span></span>
									</figcaption>
								</figure>
							)
						}
						{cifras && <p class="nota">{cifras.medicion}{linea ? ` ${linea}` : ''}</p>}
						<div class="acciones pg-pie">
							{
								demoVivaLector && (
									<a class="boton ext" href={demoVivaLector} rel="noopener">
																					{t('Probar la demo', 'Try the demo')}<span class="solo-lector">: {demoLector?.data.titulo}</span>
									</a>
								)
							}
							<a class="enlace" href={rutaDe(idioma, `/casos/${obra.id}/`)} data-salir>{t('Leer el caso completo', 'Read the full case')}</a>
						</div>
					</Pagina>
				)
			}

			<!-- 3 · Cómo trabajo -->
			<Pagina id="como-trabajo" titulo={t('Cómo trabajo', 'How I work')}>
				<h2 class="pg-sub">{t('Cómo trabajo', 'How I work')}</h2>
				<p class="principio">{partesPrincipio.map((p) => (enfasis.includes(p) ? <em>{p}</em> : p))}</p>
				<div class="parrafos der">
					{resto.map((f) => <p>{f}</p>)}
				</div>
				<dl class="datos">
					<div><dt class="rotulo">{t('Estudios', 'Studies')}</dt><dd>{estudiosActuales}</dd></div>
				</dl>
			</Pagina>

			<!-- 4 · Mi parte -->
			{
				obra && filas.length > 0 && (
					<Pagina id="que-hice-yo" titulo={t('Mi parte', 'My part')}>
							<h2 class="pg-sub">{t('Mi parte', 'My part')} <span class="resto">{t('y autoría', 'and authorship')}</span></h2>
							<div class="quien">
								<p class="rotulo">{t('Mi parte', 'My part')}</p>
							<p>{flujo ? flujo.antes : autoria?.yo}</p>
						</div>
						{
							flujo && (
								<ol class="escalera der" aria-label={t('El flujo que diseñé', 'The workflow I designed')}>
									{flujo.pasos.map((p, i) => <li class:list={{ decide: i === 2 }}><span class="num">{i + 1}</span>{p}</li>)}
								</ol>
							)
						}
						{flujo && <p class="texto">{flujo.despues}</p>}
						{
							autoria?.ia && (
								<div class="quien">
									<p class="rotulo">{t('Autoría', 'Authorship')}</p>
									<p>{autoria.ia}</p>
								</div>
							)
						}
					</Pagina>
				)
			}

			<!-- 5 · Cómo se verificó -->
			{
				obra && controles.length > 0 && (
					<Pagina id="como-se-verifico" titulo={t('Cómo se verificó', 'How it was verified')}>
						<h2 class="pg-sub">{t('Cómo se verificó', 'How it was verified')}</h2>
						{reglaCaso && <p class="regla-caso">{reglaCaso}</p>}
						<ol class="controles der">
							{controles.map((c) => <li><p>{c}</p></li>)}
						</ol>
						{notaControl && <p class="nota">{notaControl}</p>}
					</Pagina>
				)
			}

			<!-- 6 · Circuito: un paso por vez (pestañas) -->
			{
				demoLector && (
					<Pagina id="circuito" titulo={t('Circuito', 'Flow')}>
						<p class="rotulo">{t('Demo propia · datos inventados', 'My own demo · fictitious data · interface in Spanish')}</p>
						<h2 class="pg-sub">{t('Circuito de una factura', 'Flow of one invoice')}</h2>
						<div class="circuito" data-sub>
							<div class="pasos-lista" aria-label={t('Pasos del circuito', 'Steps of the flow')}>
								<span class="hilo" aria-hidden="true"><span class="hilo-lleno" /></span>
								{
									circuitoLector.map((p, i) => (
										<button type="button" data-para={`paso-${i + 1}`} class:list={{ persona: p.persona }}>
											<span class="num-paso" aria-hidden="true">{i + 1}</span>
											<span class="solo-lector">{nombrePaso(i, p, idioma)}</span>
										</button>
									))
								}
							</div>
							{
								circuitoLector.map((p, i) => (
									<div class="sub-vista" id={`paso-${i + 1}`}>
										<p class="rotulo">{t('Paso', 'Step')} {i + 1} {t('de', 'of')} {circuitoLector.length}{p.persona ? t(' · paso de una persona', ' · a person’s step') : ''}</p>
										<h3 class="sub-t">{p.titulo}</h3>
										<p class="t">{p.texto}</p>
										{
											p.acercamiento && (
												<figure class="acercamiento">
													<p class="fila"><span class="rotulo">{t('Factura', 'Invoice')}</span><span class="monto cartel">{p.acercamiento.factura}</span></p>
													<p class="fila"><span class="rotulo">{t('Sistema', 'System')}</span><span class="monto cartel">{p.acercamiento.sistema[0]}<mark>{p.acercamiento.sistema[1]}</mark></span></p>
													<figcaption class="veredicto-a">{p.acercamiento.veredicto}</figcaption>
												</figure>
											)
										}
									</div>
								))
							}
							<div class="acciones"><button class="boton siguiente" type="button" data-siguiente hidden>{t('Paso siguiente', 'Next step')} <span class="flecha" aria-hidden="true">→</span></button></div>
						</div>
					</Pagina>
				)
			}

			<!-- 7 · Prueba del centavo -->
			{
				pruebaCentavo && demoObra && (
					<Pagina id="prueba-centavo" titulo={t('Prueba: el centavo', 'Test: the cent')}>
							<p class="rotulo">{demoObra.data.titulo} · {t('prueba automática', 'automated test')}</p>
							<h2 class="pg-sub">{pruebaCentavo.titular ?? t('Prueba de la demo', 'Demo test')}</h2>
							<div class="casos der" role="table" aria-label={t('Los cuatro casos de la prueba', 'The four cases of the test')}>
								<div class="cab rotulo" role="row"><span role="columnheader">{t('Planilla', 'Spreadsheet')}</span><span role="columnheader"><span class="solo-lector">{t('Comparación', 'Comparison')}</span></span><span role="columnheader">{t('Sistema', 'System')}</span></div>
							{
								casosCentavo.map((c) => (
									<div class:list={['caso-p', { distinto: !c.igual }]} role="row">
										<span class="imp" role="cell">{c.planilla}</span>
										<span class="signo" role="cell" aria-label={c.igual ? t('igual', 'equal') : t('distinto', 'different')}>{c.igual ? '=' : '≠'}</span>
										<span class="imp der-c" role="cell">{c.sistema}</span>
										<span class="res" role="cell">{c.resultado}</span>
									</div>
								))
							}
						</div>
						<p class="autoria-p">{pruebaCentavo.autoria}</p>
						<div class="acciones pg-pie">
							<button class="ver-codigo" type="button" data-hoja="hoja-centavo" hidden>{t('Ver la prueba completa', 'See the full test')}</button>
							{
								repoLector && (
									<a class="enlace ext" href={demoObra.data.pruebaUrl ?? repoLector} rel="noopener">
																					{t('Código de la demo', 'Demo code')}<span class="solo-lector">: {demoObra.data.titulo}</span>
									</a>
								)
							}
						</div>
						<div class="codigo-flujo" id="flujo-centavo" data-titulo-hoja={t('Prueba del importe', 'Amount test')}>
							<p class="regla-p">{pruebaCentavo.regla}{idioma === 'en' && ' The code below is quoted as it is in the demo’s repository, so its test names and comments are in Spanish.'}</p>
							<div class="codigo">
								<p class="archivo"><span>{pruebaCentavo.archivo}</span><span>{pruebaCentavo.desde}–{pruebaCentavo.hasta}</span></p>
								<pre tabindex="0" role="region" aria-label={t('Código de la prueba del importe', 'Code of the amount test')}><code>{pruebaCentavo.codigo.replace(/\s+$/, '')}</code></pre>
							</div>
							<p class="que-dice"><b>{t('Qué dice', 'What it says')}</b>{pruebaCentavo.queDice}</p>
						</div>
					</Pagina>
				)
			}

			<!-- 8 · Prueba del cambio de día -->
			{
				pruebaDia && demoFlota && (
					<Pagina id="prueba-dia" titulo={t('Prueba: el día', 'Test: the day')}>
							<p class="rotulo">{demoFlota.data.titulo} · {t('prueba automática', 'automated test')}</p>
							<h2 class="pg-sub">{pruebaDia.titular ?? t('Prueba de la demo', 'Demo test')}</h2>
						<figure class="reloj der">
							<svg viewBox="0 0 300 300" role="img" aria-labelledby="reloj-t">
								<title id="reloj-t">{t('Reloj de 24 horas en UTC. Entre las 00:00 y las 03:00 UTC, en Argentina todavía es el día anterior; a las 03:00 UTC empieza el día nuevo.', '24-hour clock in UTC. Between 00:00 and 03:00 UTC it is still the previous day in Argentina; the new day starts at 03:00 UTC.')}</title>
								<path class="sector" d="M150 150 L150 34 A116 116 0 0 1 232.02 67.98 Z" />
								<circle class="aro" cx="150" cy="150" r="116" />
								{ticks.map((t) => <line class:list={['tic', { mayor: t.mayor }]} x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} />)}
								<line class="corte" x1="232.02" y1="67.98" x2="253.24" y2="46.76" />
								<text class="hora" x="150" y="22">00 UTC</text>
								<text class="hora clave" x="264" y="38">03:00</text>
								<text class="hora" x="284" y="155">06</text>
								<text class="hora" x="150" y="292">12</text>
								<text class="hora" x="16" y="155">18</text>
								<line class="aguja" x1="150" y1="150" x2="150" y2="58" />
								<circle class="centro" cx="150" cy="150" r="6" />
								<text class="rot" x="150" y="186">{t('EN ARGENTINA', 'IN ARGENTINA')}</text>
								<text class="fecha f17" x="150" y="230">{t('17/11', 'Nov 17')}</text>
								<text class="fecha f18" x="150" y="230">{t('18/11', 'Nov 18')}</text>
							</svg>
							<figcaption class="lectura-reloj">
								{lecturasReloj.map((l) => <span><b>{l.hora}</b> {l.texto}</span>)}
							</figcaption>
						</figure>
						<p class="autoria-p">{pruebaDia.autoria}</p>
						<div class="acciones pg-pie">
							<button class="ver-codigo" type="button" data-hoja="hoja-dia" hidden>{t('Ver la prueba completa', 'See the full test')}</button>
							{
								repoFlota && (
									<a class="enlace ext" href={demoFlota.data.pruebaUrl ?? repoFlota} rel="noopener">
																					{t('Código de la demo', 'Demo code')}<span class="solo-lector">: {demoFlota.data.titulo}</span>
									</a>
								)
							}
						</div>
						<div class="codigo-flujo" id="flujo-dia" data-titulo-hoja={t('Prueba del cambio de día', 'Day-change test')}>
							<p class="regla-p">{pruebaDia.regla}{idioma === 'en' && ' The code below is quoted as it is in the demo’s repository, so its test names and comments are in Spanish.'}</p>
							<div class="codigo">
								<p class="archivo"><span>{pruebaDia.archivo}</span><span>{pruebaDia.desde}–{pruebaDia.hasta}</span></p>
								<pre tabindex="0" role="region" aria-label={t('Código de la prueba del cambio de día', 'Code of the day-change test')}><code>{pruebaDia.codigo.replace(/\s+$/, '')}</code></pre>
							</div>
							<p class="que-dice"><b>{t('Qué dice', 'What it says')}</b>{pruebaDia.queDice}</p>
						</div>
					</Pagina>
				)
			}

			<!-- 9 a 11 · Las piezas propias: Método, Laboratorio y Traductor, una carta grande cada una, con su carta de atrás -->
			{
				piezas.map((p, i) => {
					const estilo = estiloDePieza(i);
					return (
						<Pagina id={idDePieza(p)} titulo={p.pagina}>
							<div class:list={['carta-grande', estilo.grande, { 'con-tras': p.filas.length > 0 }, 'der']}>
								<p class="rotulo">{t('Proyecto', 'Project')} · {textoEstadoDemo(p.estado, idioma)}</p>
								<h2 class:list={['titulo-proyecto', p.tamanoTitulo]}>{p.titulo}</h2>
								<div class="carta-textos">
									<p class="texto">{p.texto}</p>
									{p.aparte && <p class="texto-2">{p.aparte}</p>}
									{p.enlaces[0] && <a class="enlace ext" href={p.enlaces[0].url} rel="noopener">{p.enlaces[0].texto}</a>}
								</div>
								<CartaAtras nombre={p.pagina} filas={p.filas} color={estilo.atras.color} lado={estilo.atras.lado} />
							</div>
						</Pagina>
					);
				})
			}

			<!-- 11 · Trabajo independiente: referencias anónimas (sin dirección ni captura) y, con permiso del cliente, sitios completos (sin ninguno visible, esta página no existe) -->
			{
				independientes.length > 0 && (
					<Pagina id="independiente" titulo={t('Independiente', 'Independent')}>
						<p class="rotulo">{vistaPrevia ? t('Vista previa · datos ficticios', 'Preview · fictitious data') : t('Sitios para clientes', 'Client websites')}</p>
						<h2 class="pg-sub">{t('Trabajo independiente', 'Independent work')}</h2>
						<p class="texto indep-nota">{introIndependiente(independientes, idioma)}</p>
						<ul class="indep ancho">
							{
								resumen && (
									<li class="indep-carta indep-resumen">
										<h3 class="indep-titulo">{resumen.principal}</h3>
										{resumen.rubros.length > 0 && <p class="indep-rubros">{resumen.rubros.join(' · ')}</p>}
									</li>
								)
							}
							{
								independientes.filter((e) => !esReferencia(e)).map((e) => {
									const v = vistaDe(e, idioma);
									const imagen = imagenDe(v.captura);
									return (
										<li class="indep-carta">
											{imagen && v.capturaAlt && <Image class="indep-img" src={imagen} alt={v.capturaAlt} widths={[360, 720]} sizes="(min-width: 1024px) 30vw, 90vw" loading="lazy" />}
											<p class="rotulo">{[v.rubro, v.anio].filter(Boolean).join(' · ')}</p>
											<h3 class="indep-titulo">{v.titulo}</h3>
											<p class="indep-texto">{v.queSeHizo}</p>
											{v.stack.length > 0 && <p class="indep-stack">{v.stack.join(' · ')}</p>}
											{v.url && (
												<a class="enlace ext" href={v.url} rel="noopener noreferrer">
													{t('Ver el sitio', 'Visit the site')}<span class="solo-lector">: {v.titulo}</span>
												</a>
											)}
										</li>
									);
								})
							}
						</ul>
					</Pagina>
				)
			}
		</Ficha>
	</main>

	<!-- Los lomos de la portada, apuntando a la portada: la sección 02 es esta página. -->
	<Lomos salida actual="tecnico" cortina />

