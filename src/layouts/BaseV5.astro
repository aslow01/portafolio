---
// Disposición base de la web v5 «Mezcla»: metadatos, SEO, imagen social, fuentes y estilos del sistema v5 y enlace de
// salto. Solo carga un script propio en las páginas que lo piden: el de las pestañas (index.astro, y tecnico.ts y caso.ts, que lo importan).
// Y el de Cloudflare Web Analytics (al final del <head>): mide visitas sin cookies; el token es público y va en el HTML;
// la directiva de Astro que lo deja tal cual evita que lo empaquete; scripts/higiene.mjs lo admite solo con ese src exacto y public/_headers solo ese origen.
// El asistente (v5/Consulta.astro) trae el suyo solo cuando la bandera de v5/consulta/config.ts está prendida y la página no lo apaga (404 y /casos/).
// Sin estilos ni scripts en línea (la política de contenido de public/_headers no los permite): los scripts son
// módulos propios que Astro empaqueta en /_astro/ y se sirven desde el mismo origen.
// Se precargan solo las fuentes de la primera pantalla de la portada: Bricolage Grotesque (el nombre) y Schibsted Grotesk
// (los datos de las pestañas). `crossorigin` hace falta aunque el origen sea el mismo.
// El color de la barra del navegador (`theme-color`) repite --hueso (tokens.css): el atributo no admite variables CSS.
import '../styles/v5/fuentes.css';
import '../styles/v5/tokens.css';
import '../styles/v5/sistema.css';
import { tituloConNombre } from '../lib/paginas';
import { imagenSocial, nombre, textosSitio } from '../lib/sitio';
import { alternas, codigoLang, codigoOg, idiomaDe, traductor } from '../i18n/idioma';
import { configuracionConsulta } from '../v5/consulta/config';

interface Props {
	titulo: string;
	descripcion?: string;
	/** Páginas que no deben indexarse (la 404). Las redirecciones tienen su propio encabezado (v5/Redireccion.astro). */
	noindex?: boolean;
	/** Clave de la imagen de la vista previa al compartir: `portada`, `tecnico`, `logistica`, `casos` o `caso-<id>` (se generan con scripts/og/generar.mjs). */
	imagenSocial?: string;
	/** `article` en las páginas de caso; `website` en el resto. */
	tipoOg?: 'website' | 'article';
	/** A dónde salta el enlace «saltar»: por defecto, la pila de secciones de la portada. */
	saltar?: { href: string; texto: string };
	/** Clases extra de <html> (p. ej. `con-fotos`). `sin-js` siempre va: el script la reemplaza por `js`. */
	clasesHtml?: string;
	/**
	 * El asistente (v5/Consulta.astro). Por defecto va en toda página con paginador y lomos; la 404 y /casos/ lo apagan con
	 * `false` (no tienen paginador). Además lo prende la bandera de v5/consulta/config.ts: en producción, sin
	 * `PUBLIC_ASISTENTE_URL`, no se dibuja en ninguna página.
	 */
	consulta?: boolean;
}
const {
	titulo,
	descripcion,
	noindex: sinIndexar = false,
	imagenSocial: queImagen = 'portada',
	tipoOg = 'website',
	saltar: saltarPedido,
	clasesHtml = 'con-fotos',
	consulta: conConsulta = true,
} = Astro.props;
// El idioma sale de la dirección (`Astro.currentLocale`, i18n nativa de Astro): /en/… es inglés; el resto, español.
const idioma = idiomaDe(Astro.currentLocale);
const t = traductor(idioma);
const textos = textosSitio(idioma);
const saltar = saltarPedido ?? { href: '#secciones', texto: t('Ir a las secciones', 'Skip to sections') };
const descripcionFinal = descripcion ?? textos.descripcionSitio;
const asistente = conConsulta
	? configuracionConsulta({
			dev: import.meta.env.DEV,
			url: import.meta.env.PUBLIC_ASISTENTE_URL,
			sitekey: import.meta.env.PUBLIC_TURNSTILE_SITEKEY,
		})
	: null;
// Dinámico: sin asistente (el estado por defecto en producción) la página no carga ni su hoja de estilos ni su script.
// La condición es una constante del build (DEV y la variable pública se reemplazan por su valor), no el valor calculado arriba: así Vite
// descarta el `import()` y el componente, su script y su hoja no entran en ninguna página.
const Consulta = asistente && (import.meta.env.DEV || import.meta.env.PUBLIC_ASISTENTE_URL) ? (await import('../v5/Consulta.astro')).default : null;
const noindex = sinIndexar;
const tituloCompleto = tituloConNombre(titulo, nombre.completo);
const canonica = new URL(Astro.url.pathname, Astro.site);
// La imagen y su texto alternativo salen del archivo que escribe scripts/og/generar.mjs (lib/imagenes-sociales.ts).
const { archivo, alt: altImagen } = imagenSocial(queImagen, import.meta.env.DEV, idioma);
const imagen = new URL(archivo, Astro.site);
// La misma página en cada idioma, para `hreflang` (y `x-default`, que es el español).
const versiones = alternas(Astro.url.pathname, Astro.site!);
---

<!doctype html>
<html lang={codigoLang[idioma]} class={`sin-js ${clasesHtml}${asistente ? ' con-consulta' : ''}`.trim()}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="color-scheme" content="light" />
		<meta name="theme-color" content="#f0f0ec" />
		<link rel="preload" href="/fonts/bricolage-grotesque-latin-v1.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/schibsted-grotesk-latin-v1.woff2" as="font" type="font/woff2" crossorigin />
		<meta name="generator" content={Astro.generator} />
		<title>{tituloCompleto}</title>
		<meta name="description" content={descripcionFinal} />
		{noindex && <meta name="robots" content="noindex" />}
		{!noindex && <link rel="canonical" href={canonica} />}
		{!noindex && <link rel="alternate" hreflang="es-AR" href={versiones.es} />}
		{!noindex && <link rel="alternate" hreflang="en" href={versiones.en} />}
		{!noindex && <link rel="alternate" hreflang="x-default" href={versiones.es} />}
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<meta property="og:type" content={tipoOg} />
		<meta property="og:locale" content={codigoOg[idioma]} />
		{!noindex && <meta property="og:locale:alternate" content={codigoOg[idioma === 'en' ? 'es' : 'en']} />}
		<meta property="og:site_name" content={nombre.completo} />
		<meta property="og:title" content={tituloCompleto} />
		<meta property="og:description" content={descripcionFinal} />
		{!noindex && <meta property="og:url" content={canonica} />}
		<meta property="og:image" content={imagen} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={altImagen} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:image" content={imagen} />
		<meta name="twitter:image:alt" content={altImagen} />
		<script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "40d169325dab43f0a702d3a7352bc826"}'></script>
	</head>
	<body>
		<a class="saltar" href={saltar.href}>{saltar.texto}</a>
		<slot />
		{asistente && Consulta && <Consulta config={asistente} />}
	</body>
</html>
