---
// La página de caso «Expediente»: una ficha fija del color de la carpeta (Técnico e IA)
// con una tapa-carátula y las hojas claras de lectura, la cifra, la autoría y el cierre. El script de la ficha
// (pestanas.ts) le agrega el paginador. Todo el contenido sale del modelo (caso.ts); acá solo se dibuja.
// Sin JavaScript, las páginas van una debajo de la otra y la última lleva «Volver».
import Bloques from './Bloques.astro';
import EnlaceArchivo from '../EnlaceArchivo.astro';
import EnlacesDeContacto from '../EnlacesDeContacto.astro';
import type { ModeloCaso } from './caso.ts';
import type { DatosFicha } from '../datos';
import Utiles from '../Utiles.astro';
import { idiomaDe, traductor } from '../../i18n/idioma';

interface Props {
	modelo: ModeloCaso;
	/** La carpeta donde está archivado el caso (Técnico e IA, o Logística y minería). */
	carpeta: DatosFicha;
	/** Dónde vuelve «Cerrar» y el pie. */
	volver: { href: string };
	/** El subdominio de la demo propia, solo con la demo en vivo. */
	demo?: string;
	/** Solo en `npm run dev`: chapa «Borrador» en la tapa. */
	borrador?: boolean;
	nombreCaso: string;
}
const { modelo, carpeta, volver, demo, borrador = false, nombreCaso } = Astro.props;
const { titulo, caratula, paginas } = modelo;
const t = traductor(idiomaDe(Astro.currentLocale));
---

<section
	class:list={['ficha', 'fija', `c-${carpeta.color}`, `p${carpeta.posicion}`, 'expediente']}
	id="caso"
	data-nombre={`${t('Caso', 'Case')}: ${nombreCaso}`}
	aria-labelledby="t-h1"
>
	<div class="ficha-cabeza">
		<p class="oreja"><span class="num">{carpeta.numero}</span><b>{carpeta.nombre}</b></p>
		<Utiles izquierda={carpeta.posicion >= 4}>
			<a slot="cerrar" class="cerrar" href={volver.href} data-salir><span>{t('Cerrar', 'Close')}</span><span class="solo-lector">{t(`: volver a ${carpeta.nombre}`, `: back to ${carpeta.nombre}`)}</span></a>
		</Utiles>
	</div>
	<div class="hojas">
		<article class="pagina tapa" id="tapa" data-titulo={t('Tapa', 'Cover')}>
			<div class="pg">
				<p class="rotulo">{t('Caso de estudio · anonimizado', 'Case study · anonymized')}{borrador && import.meta.env.DEV && <Fragment> <span class="chapa">{t('Borrador', 'Draft')}</span></Fragment>}</p>
				<h1 class="h1-t cartel" id="t-h1" tabindex="-1">{titulo.primera}{titulo.resto && <Fragment>{' '}<span class="resto">{titulo.resto}</span></Fragment>}</h1>
				<p class="pg-lead resumen">{modelo.resumen}</p>
				{
					caratula.length > 0 && (
						<dl class="datos caratula der">
							{caratula.map((f) => (
								<div class:list={{ 'res-c': f.clave === 'resultado' }}>
									<dt class="rotulo">{f.rotulo}</dt>
									<dd>
										{f.texto}
										{f.cifra && (
											<Fragment>
												<span class="cifra-mini">
													{f.cifra.antes.map((a) => (
														<Fragment>{a}<span aria-hidden="true"> → </span><span class="solo-lector">{t(' a ', ' to ')}</span></Fragment>
													))}
													{f.cifra.ahora}
												</span>
												{f.cifra.unidad && <Fragment> {f.cifra.unidad}</Fragment>}
												<small>{f.cifra.medicion}</small>
											</Fragment>
										)}
									</dd>
								</div>
							))}
						</dl>
					)
				}
			</div>
		</article>

		{
			paginas.map((p) =>
				p.tipo === 'hoja' ? (
					<article class="pagina de-hoja" id={p.id} data-titulo={p.titulo}>
						<div class="pg c-pliego">
							{p.solapa.continuacion ? (
								<p class="solapa-h"><span class="num" aria-hidden="true">{p.solapa.numero}</span>{p.solapa.texto}<span class="sigue">{t(', continuación', ', continued')}</span></p>
							) : (
								<h2 class="solapa-h"><span class="num" aria-hidden="true">{p.solapa.numero}</span>{p.solapa.texto}</h2>
							)}
							<div class="pliego">
								<span class="folio" aria-hidden="true">{p.solapa.numero}</span>
								<div class="lectura"><Bloques bloques={p.bloques} /></div>
							</div>
						</div>
					</article>
				) : p.tipo === 'cifra' ? (
					<article class="pagina" id={p.id} data-titulo={p.titulo}>
						<div class="pg">
							<h2 class="pg-sub">{p.encabezado}</h2>
							<figure class="cifra-caso">
								<p class="cifra-c cartel">
									{p.cifra.antes.map((a) => (
										<Fragment><span class="antes">{a}</span><span class="flecha" aria-hidden="true">→</span><span class="solo-lector">{t(' a ', ' to ')}</span></Fragment>
									))}
									<span class="ahora">{p.cifra.ahora}</span>
								</p>
								<figcaption>
									{p.cifra.unidad && <span class="unidad">{p.cifra.unidad}</span>}
									<span class="medicion">{p.cifra.medicion}</span>
								</figcaption>
							</figure>
							<div class="der res-der">
								<Bloques bloques={p.parrafos} claseParrafo="texto res-texto" />
								{p.uso && (
									<dl class="datos uso">
										<div><dt class="rotulo">{t('Uso', 'In use')}</dt><dd>{p.uso}</dd></div>
									</dl>
								)}
							</div>
						</div>
					</article>
				) : p.tipo === 'autoria' ? (
					<article class="pagina" id={p.id} data-titulo={p.titulo}>
						<div class="pg">
							<h2 class="pg-sub">{t('Mi parte', 'My part')} <span class="resto">{t('y autoría', 'and authorship')}</span></h2>
							{p.filas.map((f) => (
								<div class={`quien ${f.clave}`}>
									<p class="rotulo">{f.rotulo}</p>
									<p>{f.texto}</p>
								</div>
							))}
						</div>
					</article>
				) : p.tipo === 'cierre' ? (
					<article class="pagina de-hoja cierre" id={p.id} data-titulo={p.titulo}>
						<div class="pg c-pliego">
							<h3 class="solapa-h">{p.solapa.texto}</h3>
							<div class="pliego">
								{p.verificacion && <div class="lectura"><p>{p.verificacion}</p></div>}
								<div class="salidas">
									{demo && <a class="enlace ext" href={demo} rel="noopener">{t('Ver una demo propia, escrita desde cero, sobre el mismo tipo de problema', 'See my own demo (interface in Spanish) on the same kind of problem')}</a>}
									<a class="enlace volver" href={volver.href} data-salir><span aria-hidden="true">←</span> {t('Volver a', 'Back to')} {carpeta.nombre}</a>
								</div>
							</div>
						</div>
					</article>
				) : (
					<article class="pagina de-hoja mas" id={p.id} data-titulo={p.titulo}>
						<div class="pg c-pliego">
							<h2 class="solapa-h">{p.solapa.texto}</h2>
							<div class="pliego">
								<ul class="cartas">
									{p.casos.map((c) => (
										<li>
											<p class="rotulo">{c.rotulo}{c.borrador && import.meta.env.DEV && <Fragment> <span class="chapa">{t('Borrador', 'Draft')}</span></Fragment>}</p>
											<a class="carta-enlace" href={c.href}>{c.titulo}<span class="flecha" aria-hidden="true"> →</span></a>
										</li>
									))}
									{p.todos && (
										<li class="todos">
											<EnlaceArchivo total={p.todos.total} texto={p.todos.texto} />
										</li>
									)}
								</ul>
								<div class="salidas contacto">
									<EnlacesDeContacto camino={carpeta.id === 'logistica' ? 'logistica' : 'tecnico'} />
								</div>
							</div>
						</div>
					</article>
				),
			)
		}
	</div>
</section>
