# Cabeceras de seguridad (Cloudflare Pages). Se prueban en scripts/cabeceras.test.mjs.
# Fuera del propio origen se admiten tres cosas: el Worker del asistente (asistente.matiasormeno.com.ar, en connect-src), Turnstile de
# Cloudflare (challenges.cloudflare.com, en script-src, frame-src y connect-src) y Cloudflare Web Analytics (sin cookies: el beacon sale de
# static.cloudflareinsights.com, en script-src, y envía la medición a cloudflareinsights.com, en connect-src). El widget del asistente no pide
# nada a terceros hasta que el visitante manda su primera pregunta, y sin PUBLIC_ASISTENTE_URL en el build ni se monta (docs-asistente/activar-csp.md).
# HSTS: 180 días, con subdominios (facturas., flota., tablero. y www. responden por HTTPS), sin preload.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com https://challenges.cloudflare.com; connect-src 'self' https://cloudflareinsights.com https://asistente.matiasormeno.com.ar https://challenges.cloudflare.com; style-src 'self'; img-src 'self'; font-src 'self'; object-src 'none'; frame-src https://challenges.cloudflare.com; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  Strict-Transport-Security: max-age=15552000; includeSubDomains
  X-Content-Type-Options: nosniff
  Cross-Origin-Opener-Policy: same-origin
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

# Archivos con nombre por contenido (hash): se pueden guardar para siempre.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Fuentes autoalojadas: el nombre lleva versión (-v1); si un archivo cambia, cambia el nombre.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Imágenes para compartir (public/og/): el nombre lleva la huella de su contenido (scripts/og/generar.mjs), así que se guardan para siempre.
/og/*
  Cache-Control: public, max-age=31536000, immutable
